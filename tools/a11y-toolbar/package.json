{
  "name": "@free-ai/accessibility-toolbar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "User-controlled accessibility display preferences toolbar (Hebrew/RTL and English/LTR).",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "sideEffects": [
    "./src/auto.ts",
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
